{
  "manifest_version": 3,
  "name": "WhiteDot · 浏览器校对",
  "description": "配合本机 WhiteDot，在当前英文输入框中显示可点选的校对红线。",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {"default_popup": "popup.html", "default_title": "WhiteDot 配对"},
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["editor.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }]
}
